{
  "env": {
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "ponytail@ponytail": true,
    "linear@anthropic-plugin-directory": true,
    "neon-postgres@neon": true,
    "mattpocock-skills@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "theme": "auto",
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "soft_deny": [
      "$defaults",
      "Bash(railway:* deploy* --environment production*)",
      "Bash(railway:* --environment production*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/zsh -c 'export PATH=\"/opt/homebrew/bin:/usr/local/bin:$PATH\"; if command -v node >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && [ -f \"$HOME/.agents/skills/do-factory-setup/check-skills.ts\" ]; then node \"$HOME/.agents/skills/do-factory-setup/check-skills.ts\" 2>/dev/null | jq -Rs \"if length > 0 then {systemMessage: rtrimstr(\\\"\\n\\\")} else empty end\"; fi; exit 0'",
            "timeout": 5,
            "statusMessage": "Checking Factory skills"
          }
        ]
      }
    ]
  }
}
